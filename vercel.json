{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": {
    "api/compose.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/tunelm/api/compose", "destination": "/api/compose" },
    { "source": "/tunelm", "destination": "/tunelm/index.html" },
    { "source": "/tunelm/", "destination": "/tunelm/index.html" }
  ],
  "headers": [
    {
      "source": "/tunelm/assets/pattern-worker.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; connect-src 'none'"
        }
      ]
    }
  ]
}
